# -- Environment files (NEVER commit secrets) --
.env
.env.*
!.env.example
!.env.template

# -- Dependencies --
node_modules/

# -- IDE settings --
.vscode/
.idea/
client/.idea/

# -- Build output --
client/dist/

# -- OS files --
.DS_Store
Thumbs.db
*.stackdump

# -- Debug logs --
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -- Runtime --
*.pid
*.seed
*.pid.lock
